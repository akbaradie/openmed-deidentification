# Copy to .env and adjust. Never commit the real .env (already gitignored).

# --- Runtime profile ---
# "prod" enables production timeouts/limits; "test" is for local iteration.
OPENMED_PROFILE=prod

# --- Model warm pool ---
# Model this service is built around. Preloading avoids a cold-start hit on
# the first request and keeps it resident under the warm pool.
OPENMED_SERVICE_PRELOAD_MODELS=OpenMed/privacy-filter-multilingual-v2
# Cap resident models; LRU-evicts anything beyond this when other models get loaded.
OPENMED_SERVICE_MAX_RESIDENT_MODELS=1
# Idle unload timing for warm models not in OPENMED_SERVICE_PRELOAD_MODELS.
OPENMED_SERVICE_KEEP_ALIVE=10m

# --- Batching & coalescing (throughput under concurrent load) ---
OPENMED_SERVICE_BATCHING_ENABLED=true
OPENMED_SERVICE_BATCH_MAX_SIZE=32
OPENMED_SERVICE_BATCH_MAX_WAIT_MS=50
OPENMED_SERVICE_COALESCING_ENABLED=true

# --- Request limits ---
OPENMED_SERVICE_MAX_TEXT_LENGTH=1000000

# --- Network security ---
# Comma-separated exact origins; leave empty to keep CORS closed.
OPENMED_SERVICE_CORS_ORIGINS=
# Host header allowlist. Add your public hostname (e.g. ngrok domain, LB hostname).
OPENMED_SERVICE_TRUSTED_HOSTS=localhost,127.0.0.1

# --- Resilience ---
OPENMED_SERVICE_RETRY_MAX_ATTEMPTS=3
OPENMED_SERVICE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
OPENMED_SERVICE_CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30
OPENMED_SERVICE_SHUTDOWN_DRAIN_SECONDS=30

# --- Observability ---
OPENMED_SERVICE_METRICS_ENABLED=true
OPENMED_SERVICE_TRACING_ENABLED=false
# OPENMED_SERVICE_OTLP_ENDPOINT=http://otel-collector:4317

# --- Hugging Face ---
# Required only if the model repo is gated/private.
HF_TOKEN=
HF_HOME=/data/hf-cache

# --- Auth (enforced by manage.py, in-process -- required, not optional) ---
# The service refuses to start without this set. Every request needs a
# matching X-API-Key header, except /health, /livez, /readyz. Same check on
# the VM and on Cloud Run (see scripts/deploy_cloud_run.sh, which stores
# this in Secret Manager instead of as a plain env var).
OPENMED_API_KEY=change-me

# --- Port (Cloud Run injects its own PORT and expects the container to
# listen on it; defaults to 8080 for local/VM use) ---
PORT=8080

# --- Colab / tunnel (used by scripts/run_colab.sh only) ---
NGROK_AUTH_TOKEN=
NGROK_HOSTNAME=
